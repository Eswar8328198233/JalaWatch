# ==========================================
# JalaWatch Mobile Configuration
# ==========================================

# Production Cloud Backend (Default on Render):
EXPO_PUBLIC_API_URL=https://jalawatch.onrender.com

# Local Development Options:
# Wi-Fi LAN IP (Phone and laptop on same Wi-Fi network):
# EXPO_PUBLIC_API_URL=http://192.168.29.89:5000

# USB Cable via ADB Reverse (adb reverse tcp:5000 tcp:5000):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# Android Emulator loopback:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
