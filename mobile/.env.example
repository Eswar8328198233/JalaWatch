# ==========================================================
# JalaWatch Mobile Environment Configuration
# ==========================================================

# Local Development (Laptop Wi-Fi or USB adb reverse):
# EXPO_PUBLIC_API_URL=http://192.168.29.89:5000

# Production Cloud Backend (HTTPS):
# Once you deploy the Flask backend to Render, Railway, or Fly.io,
# replace with your live HTTPS domain:
# EXPO_PUBLIC_API_URL=https://<YOUR-APP-NAME>.onrender.com
