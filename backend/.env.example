# ==========================================
# JalaWatch Backend Configuration
# ==========================================

# Environment mode ('development' or 'production')
FLASK_ENV=production
FLASK_DEBUG=0

# Server port (assigned automatically by cloud hosts like Render/Railway)
PORT=5000

# Secret Key for JWT signature & sessions
# In production, generate a secure random 64-char key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_key_in_production_2026

# Administrator Credentials (Created on first database initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisSecurePassword@2026
ADMIN_EMAIL=admin@jalawatch.org

# ==========================================
# Database Configuration
# ==========================================
# Option A: Managed PostgreSQL (Recommended for production persistence: Neon, Render, Supabase)
# For Neon Serverless PostgreSQL (pooled endpoint recommended for serverless/Render):
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# Option B: Persistent SQLite file on mounted volume
DATABASE_PATH=jalawatch.db
# On Render Persistent Disk: DATABASE_PATH=/var/data/jalawatch.db

# ==========================================
# Persistent Photo Storage
# ==========================================
# Option A: Cloudinary Object Storage (Recommended, free tier 25GB)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or via individual keys:
# CLOUDINARY_CLOUD_NAME=ckufwfev
# CLOUDINARY_API_KEY=756738857651315
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Option B: Local Disk (Fallback, requires persistent disk on hosting)
UPLOAD_FOLDER=uploads
# On Render Persistent Disk: UPLOAD_FOLDER=/var/data/uploads

# Max Upload Size in bytes (5MB = 5242880)
MAX_CONTENT_LENGTH=5242880
