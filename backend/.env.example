# ==========================================
# JalaWatch Backend Configuration
# ==========================================

# Environment mode ('development' or 'production')
FLASK_ENV=production
FLASK_DEBUG=0

# Server port (assigned automatically by cloud hosts like Render/Railway)
PORT=5000

# Secret Key for JWT signature & sessions
# In production, generate a secure random 64-char key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_key_in_production_2026

# Administrator Credentials (Created on first database initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisSecurePassword@2026
ADMIN_EMAIL=admin@jalawatch.org

# Database & Upload Storage Configuration
# For Local Dev: Relative path stored inside the project folder
# DATABASE_PATH=jalawatch.db
# UPLOAD_FOLDER=uploads

# For Cloud Deployment (Persistent Disk / Volume):
# Set to the absolute path of your mounted volume so data persists across restarts
# Render Persistent Disk:
DATABASE_PATH=/var/data/jalawatch.db
UPLOAD_FOLDER=/var/data/uploads

# Railway Volume:
# DATABASE_PATH=/data/jalawatch.db
# UPLOAD_FOLDER=/data/uploads

# Max Upload Size (5MB)
MAX_CONTENT_LENGTH=5242880
